.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# colcon workspace artifacts under ws/. These three patterns are unanchored,
# so they match at any depth and cover ws/build, ws/install and ws/log.
build/
install/
log/
*.png
!docs/*.png
*.gif
!docs/*.gif
*.mp4
data/*.npz
# The approach dataset is regenerable from examples/render_target_views.py,
# and data/*.npz above does not reach a nested directory.
data/**/*.npz

data/*.pt
