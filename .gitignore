.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# colcon workspace artifacts under ws/. These three patterns are unanchored,
# so they match at any depth and cover ws/build, ws/install and ws/log.
build/
install/
log/
*.png
!docs/*.png
*.gif
!docs/*.gif
*.mp4
data/*.npz
# The approach dataset is regenerable from examples/render_target_views.py,
# and data/*.npz above does not reach a nested directory.
data/**/*.npz

data/*.pt
data/*.npz

# The fit_target sweep's results record. Its companion predictions file is
# already covered by data/*.npz above, and the two are only useful as a pair,
# so they are ignored together the way every other derived file under data/ is.
data/fit_scaling.json
